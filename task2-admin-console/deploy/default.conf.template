server {
    listen 3000;
    root /usr/share/nginx/html;

    # The browser can't resolve Docker service names, so API calls go through here.
    # Using a variable makes nginx re-resolve the name if mock-api restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        set $api_upstream ${API_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location / {
        try_files $uri /index.html;
    }
}
