# Optional. `docker compose up` works without this file by using local-only
# defaults. Copy to `.env` to override them; `.env` is git-ignored.

WEBHOOK_SECRET=callzo_test_secret_change_me
API_KEY=local-dev-api-key
POSTGRES_PASSWORD=local-dev-password

# $5.00. Low enough that the simulator's cap_burst scenario crosses it.
MONTHLY_CAP_CENTS=500
# Days after a month ends during which late events still count towards it.
MONTH_GRACE_DAYS=3
